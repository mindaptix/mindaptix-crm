# DSR AI review: server-only credentials; never use NEXT_PUBLIC_ prefixes.
GROQ_API_KEY=
# Optional second reviewer. Groq works on its own when this is blank.
OPENAI_API_KEY=
GROQ_DSR_MODEL=openai/gpt-oss-120b
OPENAI_DSR_MODEL=gpt-4o-mini
# Optional 32+ character secret used to encrypt API keys saved from Settings.
# SESSION_SECRET is used when this is blank.
AI_SETTINGS_ENCRYPTION_KEY=
# Comma-separated repositories approved to share bounded diffs with AI providers.
DSR_GITHUB_ALLOWED_REPOS=your-org/your-repository
# Optional for public repos; required for private repos. Use a fine-grained token
# restricted to approved repositories with Contents: read-only permission.
GITHUB_TOKEN=
# Holiday reminder emails. Set these in production; Vercel runs the cron daily at 08:30 IST.
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Mindaptix CRM <notifications@your-domain.com>
