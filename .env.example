# DSR AI review: server-only credentials; never use NEXT_PUBLIC_ prefixes.
GROQ_API_KEY=
OPENAI_API_KEY=
GROQ_DSR_MODEL=openai/gpt-oss-120b
OPENAI_DSR_MODEL=gpt-4o-mini
# Comma-separated repositories approved to share bounded diffs with AI providers.
DSR_GITHUB_ALLOWED_REPOS=your-org/your-repository
# Optional for public repos; required for private repos. Use a fine-grained token
# restricted to approved repositories with Contents: read-only permission.
GITHUB_TOKEN=
